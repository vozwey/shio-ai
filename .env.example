# Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI-совместимый API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=deepseek-v4-flash
OPENAI_TEMPERATURE=1.0
OPENAI_MAX_TOKENS=1500

# Память (SQLite — загружается при старте, дальше только RAM)
MEMORY_DB_PATH=porno.db

# Логирование
LOG_LEVEL=INFO

# Лимиты
ANSWER_MAX_CHAR=4000

# Память
CONTEXT_SIZE=20
SNIPPET_CONTEXT_CHARS=25
SEARCH_MAX_RESULTS=20

# 4get: поиск в интернете
FOURGET_BASE_URL=https://4get.joygnu.org

# Тул-коллинг
TOOL_MAX_ITERATIONS=5
TOOL_RESULT_MAX_CHAR=2000
